# MoodTune — environment variables
# 复制本文件为 .env.local 并填入真实密钥（.env.local 不会被提交）

# 智谱 GLM —— 推荐引擎（OpenAI 兼容模式）
ZHIPUAI_API_KEY=

# OpenWeatherMap —— 顶栏天气
OPENWEATHER_API_KEY=

# Spotify —— OAuth（Authorization Code + PKCE）与播放
# 在 https://developer.spotify.com/dashboard 创建 app 后获取
SPOTIFY_CLIENT_ID=
# 纯 PKCE 流程的 token 交换不发送 client secret；此项仅为 Dashboard 一并
# 提供、未来若切换机密客户端流程时备用，当前实现不使用它。
SPOTIFY_CLIENT_SECRET=
# 必须与 Spotify Dashboard 里登记的 Redirect URI 完全一致。
# 用 127.0.0.1（Spotify 已不允许 localhost）—— 浏览器访问也要用同一个 host。
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# YouTube Data API v3 —— 播放引擎用它把「歌名 歌手」解析成可播放的视频
# 在 https://console.cloud.google.com 启用 YouTube Data API v3 后创建 API key
YOUTUBE_API_KEY=
